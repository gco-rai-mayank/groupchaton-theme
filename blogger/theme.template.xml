<!-- ======================= POSTS, PAGES AND LISTS ======================= -->
<div class='container page-wrap'>
  <b:section class='blog-section' id='posts' name='Blog Posts' showaddelement='yes'>
    <b:widget id='Blog1' locked='true' title='Blog Posts' type='Blog' version='2' visible='true'>
      <!-- Keep this gadget to the Blogger data that is proven to render (the same as on ShareYourGroup):
           post url, title, body, labels, featured image and pager links. If any expression fails,
           Blogger silently drops the whole gadget and every page goes blank. Dates, thumbnails,
           list titles and the comments box are added by gco.js instead. -->
      <b:includable id='main' var='this'>
        <b:if cond='data:view.isMultipleItems'>
          <div class='reading'>
            <h1 class='list-title' hidden='hidden'>Chapters</h1>
            <div class='post-list'>
              <b:loop values='data:posts' var='post'>
                <article class='post-row'>
                  <b:attr cond='data:post.featuredImage' expr:value='resizeImage(data:post.featuredImage, 640, &quot;16:9&quot;)' name='data-img'/>
                  <div class='row-text'>
                    <h3><a expr:href='data:post.url'><data:post.title/></a></h3>
                    <div class='row-meta'/>
                  </div>
                </article>
              </b:loop>
            </div>
            <div class='blog-pager' id='blog-pager'>
              <b:if cond='data:newerPageUrl'><a class='btn btn-sm' expr:href='data:newerPageUrl'>&#8592; Newer</a></b:if>
              <b:if cond='data:olderPageUrl'><a class='btn btn-sm pager-older' expr:href='data:olderPageUrl'>Older chapters &#8594;</a></b:if>
            </div>
          </div>
        <b:else/>
          <b:loop values='data:posts' var='post'>
            <article class='reading post'>
              <div class='crumb'><a href='/'>Home</a></div>
              <h1 class='post-title entry-title'><data:post.title/></h1>
              <div class='post-meta'/>
              <div class='post-body entry-content' expr:id='&quot;post-body-&quot; + data:post.id'>
                <data:post.body/>
              </div>
              <b:if cond='data:post.labels'>
                <div class='post-labels'>
                  <b:loop values='data:post.labels' var='label'><a expr:href='data:label.url' rel='tag'><data:label.name/></a></b:loop>
                </div>
              </b:if>
            </article>
          </b:loop>
        </b:if>
      </b:includable>
    </b:widget>
  </b:section>
  <aside aria-label='Sponsored' class='rail'><div class='rail-inner'/></aside>
